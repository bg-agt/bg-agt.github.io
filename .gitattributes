# Store text files with LF line endings regardless of OS
* text=auto eol=lf

# Binary assets: never touch line endings or diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.mp4   binary
*.webm  binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.exe   binary
